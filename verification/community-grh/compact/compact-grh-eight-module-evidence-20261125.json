      "source": "import Lean.Environment\nimport Lean.Util.FoldConsts\n\nopen Lean\n\nunsafe def main (args : List String) : IO UInt32 := do\n  let [path] := args | throw (IO.userError \"provide the .olean path\")\n  let parts ← readModuleDataParts #[path, path ++ \".server\", path ++ \".private\"]\n  for (data, _) in parts do\n    let mut direct := #[]\n    for c in data.constants do\n      if c.getUsedConstantsAsSet.contains `sorryAx then\n        direct := direct.push c.name\n    IO.println s!\"{data.constants.size} declarations, direct sorryAx references: {direct}\"\n    for (n, entries) in data.entries do\n      if (toString n).contains \"exportedAxiomsExt\" then\n        IO.println s!\"{entries.size} entries in {n}\"\n        let table : Array (Name × Array Name) := unsafeCast entries\n        let allowed := [`propext, `Classical.choice, `Quot.sound]\n        if table.size == 0 then throw (IO.userError \"empty axiom table\")\n        let mut bad := #[]\n        for (decl, axioms) in table do\n          if !data.constNames.contains decl then\n            throw (IO.userError s!\"foreign declaration {decl}\")\n          let nonstandard := axioms.filter (fun a => !(allowed.contains a))\n          if !nonstandard.isEmpty then bad := bad.push (decl, nonstandard)\n        IO.println s!\"{table.size} audited transitive axiom entries, {bad.size} offending: {bad}\"\n\n  return 0\n",
