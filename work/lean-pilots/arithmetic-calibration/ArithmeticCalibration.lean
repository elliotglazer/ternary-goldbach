namespace Replay
def renamed (names : Array Name) (e : Expr) : Expr := e.replace fun x =>
  match x with
  | .const n us => match names.findIdx? (fun old => old == n) with
    | some i => some (.const (Name.num `Trial i) us)
    | none => none
  | _ => none

def pool (env : Environment) (names : Array Name) : IO (Array Declaration) := do
  let mut ds := #[]
  for i in [:names.size] do
    match env.find? names[i]! with
    | some (.thmInfo v) =>
      ds := ds.push (.thmDecl {name := Name.num `Trial i, levelParams := v.levelParams,
        type := renamed names v.type, value := renamed names v.value})
    | _ => throw (IO.userError s!"missing theorem {names[i]!}")
  return ds

def checkBundle (base : Kernel.Environment) (ds : Array Declaration) (hb rec : USize) : IO Nat := do
  let mut env := base
  let mut count := 0
  for d in ds do
    match env.addDeclCore hb rec d none with
    | .ok next => env := next; count := count+1
    | .error _ => throw (IO.userError s!"kernel rejected auxiliary index {count}")
  return count

def measure (env : Environment) (names : Array Name) (p f reps : Nat) (hb rec : USize) : IO Unit := do
  let tgen ← IO.monoNanosNow
  let ds ← pool env names
  let tend ← IO.monoNanosNow
  let base := env.toKernelEnv
  discard <| checkBundle base ds hb rec
  -- Corrupt the actual first multiplication type but retain its proof.
  let d := ds[5]!
  let bad := match d with
    | .thmDecl v => .thmDecl {v with type := mkConst ``False}
    | _ => d
  let rejected := match base.addDeclCore hb rec bad none with
    | .error _ => true
    | .ok _ => false
  if !rejected then throw (IO.userError "corrupt declaration accepted")
  let t0 ← IO.monoNanosNow
  let mut accepted := 0
  for _ in [:reps] do
    accepted := accepted + (← checkBundle base ds hb rec)
  let t1 ← IO.monoNanosNow
  IO.println s!"RESULT,{p},{f},{reps},{ds.size},{accepted},{rejected},{tend-tgen},{t1-t0}"
  (← IO.getStdout).flush

