def SpectralPilot.sampleS : ℂ :=
1 / 2 + Complex.I * (5 / 64)
def SpectralPilot.chi4 : DirichletCharacter ℂ 4 :=
ZMod.χ₄.ringHomComp (Int.castRingHom ℂ)
def SpectralPilot.logApprox : ℕ → ℕ → ℝ :=
fun n k => ↑k * SpectralPilot.logSeries (1 / 3) + SpectralPilot.logSeries ((↑n - 2 ^ k) / (↑n + 2 ^ k))
def SpectralPilot.powerCenter : ℕ → ℕ → ℂ :=
fun n k => SpectralPilot.expSeries (-SpectralPilot.sampleS * ↑(SpectralPilot.logApprox n k))
def SpectralPilot.roundedInput : Fin 8 → ℂ :=
fun j =>
  ![SpectralPilot.rounded1, SpectralPilot.rounded3, SpectralPilot.rounded5, SpectralPilot.rounded7,
      SpectralPilot.rounded9, SpectralPilot.rounded11, SpectralPilot.rounded13, SpectralPilot.rounded15]
    j
def SpectralPilot.finiteSample : ℂ :=
∑ n ∈ Finset.Icc 1 16, SpectralPilot.chi4 ↑n * ↑n ^ (-SpectralPilot.sampleS)
def SpectralPilot.sampleTail : ℂ :=
SpectralPilot.sampleS *
  ∫ (t : ℝ) in Set.Ioi 16, TernaryGoldbach.Explicit.psum SpectralPilot.chi4 ⌊t⌋₊ * ↑t ^ (-(SpectralPilot.sampleS + 1))
SpectralPilot.chi4_nat (n : ℕ) : SpectralPilot.chi4 ↑n = if n % 2 = 0 then 0 else if n % 4 = 1 then 1 else -1
SpectralPilot.psum_chi4 (n : ℕ) :
  TernaryGoldbach.Explicit.psum SpectralPilot.chi4 n = if n % 4 = 1 ∨ n % 4 = 2 then 1 else 0
SpectralPilot.logSeries_error {x : ℝ} (hx0 : 0 ≤ x) (hx : x ≤ 1 / 3) :
  |Real.log ((1 + x) / (1 - x)) - SpectralPilot.logSeries x| ≤ 1 / 50000000
SpectralPilot.expSeries_error {z : ℂ} (hz : ‖z‖ ≤ 2) : ‖Complex.exp z - SpectralPilot.expSeries z‖ ≤ 1 / 10000000
SpectralPilot.exp_transport {x y : ℂ} (hx : x.re ≤ 0) (hxy : ‖y - x‖ ≤ 1) :
  ‖Complex.exp y - Complex.exp x‖ ≤ 2 * ‖y - x‖
SpectralPilot.logApprox_error {n k : ℕ} (hn : 0 < n) (hk : k ≤ 3) (hlo : 2 ^ k ≤ ↑n) (hhi : ↑n ≤ 2 * 2 ^ k) :
  |Real.log ↑n - SpectralPilot.logApprox n k| ≤ 1 / 10000000
SpectralPilot.powerCenter_error {n k : ℕ} (hn : 0 < n) (hN : n ≤ 16) (hk : k ≤ 3) (hlo : 2 ^ k ≤ ↑n)
  (hhi : ↑n ≤ 2 * 2 ^ k) : ‖↑n ^ (-SpectralPilot.sampleS) - SpectralPilot.powerCenter n k‖ ≤ 3 / 10000000
SpectralPilot.round1_error : ‖SpectralPilot.powerCenter 1 0 - SpectralPilot.rounded1‖ ≤ 1 / 1048576
SpectralPilot.round3_error : ‖SpectralPilot.powerCenter 3 1 - SpectralPilot.rounded3‖ ≤ 1 / 1048576
SpectralPilot.round5_error : ‖SpectralPilot.powerCenter 5 2 - SpectralPilot.rounded5‖ ≤ 1 / 1048576
SpectralPilot.round7_error : ‖SpectralPilot.powerCenter 7 2 - SpectralPilot.rounded7‖ ≤ 1 / 1048576
SpectralPilot.round9_error : ‖SpectralPilot.powerCenter 9 3 - SpectralPilot.rounded9‖ ≤ 1 / 1048576
SpectralPilot.round11_error : ‖SpectralPilot.powerCenter 11 3 - SpectralPilot.rounded11‖ ≤ 1 / 1048576
SpectralPilot.round13_error : ‖SpectralPilot.powerCenter 13 3 - SpectralPilot.rounded13‖ ≤ 1 / 1048576
SpectralPilot.round15_error : ‖SpectralPilot.powerCenter 15 3 - SpectralPilot.rounded15‖ ≤ 1 / 1048576
SpectralPilot.input1_error : ‖1 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded1‖ ≤ 1 / 500000
SpectralPilot.input3_error : ‖3 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded3‖ ≤ 1 / 500000
SpectralPilot.input5_error : ‖5 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded5‖ ≤ 1 / 500000
SpectralPilot.input7_error : ‖7 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded7‖ ≤ 1 / 500000
SpectralPilot.input9_error : ‖9 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded9‖ ≤ 1 / 500000
SpectralPilot.input11_error : ‖11 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded11‖ ≤ 1 / 500000
SpectralPilot.input13_error : ‖13 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded13‖ ≤ 1 / 500000
SpectralPilot.input15_error : ‖15 ^ (-SpectralPilot.sampleS) - SpectralPilot.rounded15‖ ≤ 1 / 500000
SpectralPilot.roundedInput_error (j : Fin 8) :
  ‖↑(2 * ↑j + 1) ^ (-SpectralPilot.sampleS) - SpectralPilot.roundedInput j‖ ≤ 1 / 500000
SpectralPilot.actual_sample_split :
  DirichletCharacter.LFunction SpectralPilot.chi4 SpectralPilot.sampleS =
    SpectralPilot.finiteSample + SpectralPilot.sampleTail
SpectralPilot.sampleTail_bound : ‖SpectralPilot.sampleTail‖ ≤ 33 / 128
SpectralPilot.finiteSample_eq_indexed : SpectralPilot.finiteSample = SpectralPilot.indexedSample
SpectralPilot.finiteRounded_eval : SpectralPilot.finiteRounded = 572952 / 1048576 + Complex.I * (51250 / 1048576)
SpectralPilot.finiteSample_rounding_error : ‖SpectralPilot.finiteSample - SpectralPilot.finiteRounded‖ ≤ 1 / 62500
SpectralPilot.actual_sample_disk :
  ‖DirichletCharacter.LFunction SpectralPilot.chi4 SpectralPilot.sampleS - SpectralPilot.finiteRounded‖ ≤
    33 / 128 + 1 / 62500
'SpectralPilot.roundedInput_error' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralPilot.actual_sample_split' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralPilot.sampleTail_bound' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralPilot.finiteSample_eq_indexed' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralPilot.finiteRounded_eval' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralPilot.finiteSample_rounding_error' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralPilot.actual_sample_disk' depends on axioms: [propext, Classical.choice, Quot.sound]
