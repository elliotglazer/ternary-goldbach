SpectralAbelPilot.finite_abel (g : ℕ → ℂ) (N : ℕ) (s : ℂ) (hs : 0 < s.re) :
  ∑ k ∈ Finset.Icc 1 N, g k * ↑k ^ (-s) =
    (∑ k ∈ Finset.Icc 1 N, g k) * ↑N ^ (-s) +
      s * ∫ (t : ℝ) in Set.Ioc 1 ↑N, (∑ k ∈ Finset.Icc 1 ⌊t⌋₊, g k) * ↑t ^ (-(s + 1))
SpectralAbelPilot.LFunction_finite_abel {q : ℕ} [NeZero q] {χ : DirichletCharacter ℂ q} (hχ : χ ≠ 1) {s : ℂ}
  (hs : 0 < s.re) {N : ℕ} (hN : 1 ≤ N) :
  DirichletCharacter.LFunction χ s =
    ∑ k ∈ Finset.Icc 1 N, χ ↑k * ↑k ^ (-s) - TernaryGoldbach.Explicit.psum χ N * ↑N ^ (-s) +
      s * ∫ (t : ℝ) in Set.Ioi ↑N, TernaryGoldbach.Explicit.psum χ ⌊t⌋₊ * ↑t ^ (-(s + 1))
'SpectralAbelPilot.finite_abel' depends on axioms: [propext, Classical.choice, Quot.sound]
'SpectralAbelPilot.LFunction_finite_abel' depends on axioms: [propext, Classical.choice, Quot.sound]
