RawHead.mulStep_error {S T : ℕ} (hS : 0 < S) (hT : 0 < T) (u v : ℤ × ℤ) :
  ‖RawHead.expIntegerValue S (RawHead.mulStep T u v) - RawHead.expIntegerValue S u * RawHead.expIntegerValue T v‖ ≤
    1 / ↑S
RawHead.rawStateValue_error {x k j : ℕ} (hx : 0 < x) (hk : k ≤ 18) (hlo : 2 ^ k ≤ x) (hhi : x ≤ 2 * 2 ^ k)
  (hj : j ≤ 90000) : ‖RawHead.rawStateValue k x j - RawHead.integerPower (↑x) (↑j * 5 / 64)‖ < 1 / 2 ^ 96
RawHead.rawTrueStep_power (x j : ℕ) :
  RawHead.integerPower (↑x) 0 * RawHead.rawTrueStep x ^ j = RawHead.integerPower (↑x) (↑j * 5 / 64)
'RawHead.mulStep_error' depends on axioms: [propext, Classical.choice, Quot.sound]
'RawHead.rawStateInitial_value' depends on axioms: [propext, Classical.choice, Quot.sound]
'RawHead.rawStateValue_update_error' depends on axioms: [propext, Classical.choice, Quot.sound]
'RawHead.rawTrueStep_power' depends on axioms: [propext, Classical.choice, Quot.sound]
'RawHead.rawStateValue_error' depends on axioms: [propext, Classical.choice, Quot.sound]
