prefix b0b: $b0b$ prec max;
term b0c : byte;
prefix b0c: $b0c$ prec max;
term b0d : byte;
prefix b0d: $b0d$ prec max;
term b0e : byte;
prefix b0e: $b0e$ prec max;
term b0f : byte;
prefix b0f: $b0f$ prec max;
term wordpack (x0:byte) (x1:byte) (x2:byte) (x3:byte) (x4:byte) (x5:byte) (x6:byte) (x7:byte) (x8:byte) (x9:byte) (x10:byte) (x11:byte) (x12:byte) (x13:byte) (x14:byte) (x15:byte): word;
prefix wordpack: $wordpack$ prec 1000;
term sourcepack (x0:byte) (x1:byte) (x2:byte) (x3:byte) (x4:byte) (x5:byte) (x6:byte) (x7:byte) (x8:byte) (x9:byte) (x10:byte) (x11:byte) (x12:byte) (x13:byte) (x14:byte) (x15:byte) (x16:byte): source;
prefix sourcepack: $sourcepack$ prec 1000;
term nil : trace;
prefix nil: $nil$ prec max;
term step (x0:trace) (x1:word) (x2:source) (x3:word): trace;
prefix step: $step$ prec 1000;
term valid (x0:trace) (x1:word): prop;
prefix valid: $valid$ prec 1000;
term ok : prop;
prefix ok: $ok$ prec max;
term byteor (x0:byte) (x1:byte) (x2:byte): prop;
prefix byteor: $byteor$ prec 1000;
term byteslice (x0:byte) (x1:byte) (x2:byte): prop;
prefix byteslice: $byteslice$ prec 1000;
axiom empty (x0:byte) : $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $;
axiom clear (x0:byte) (h0: $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $): $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $;
axiom drop22 (x0:byte) (x1:byte) (x2:byte) (h0: $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $) (h1: $ (byteor x0 x1 x2) $): $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $;
axiom drop23 (x0:byte) (x1:byte) (x2:byte) (h0: $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $) (h1: $ (byteslice x0 x1 x2) $): $ (valid nil (wordpack b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00 b00)) $;
