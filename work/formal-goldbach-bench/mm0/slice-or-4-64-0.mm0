delimiter $ ( $ $ ) $;
strict free sort byte;
strict free sort word;
strict free sort source;
strict free sort trace;
provable sort prop;
term b00 : byte;
prefix b00: $b00$ prec max;
term b01 : byte;
prefix b01: $b01$ prec max;
term b02 : byte;
prefix b02: $b02$ prec max;
term b03 : byte;
prefix b03: $b03$ prec max;
term b04 : byte;
prefix b04: $b04$ prec max;
term b05 : byte;
prefix b05: $b05$ prec max;
term b06 : byte;
prefix b06: $b06$ prec max;
term b07 : byte;
prefix b07: $b07$ prec max;
term b08 : byte;
prefix b08: $b08$ prec max;
term b09 : byte;
