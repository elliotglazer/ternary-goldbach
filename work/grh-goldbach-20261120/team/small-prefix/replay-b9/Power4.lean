import PrefixSource
namespace SmallGoldbach.Power4
open PrimeCoverage SmallGoldbach
set_option maxRecDepth 20000
set_option maxHeartbeats 0
def segmentsPart0 : List Segment := [⟨0, 2, 3, 0x200010000⟩,
  ⟨3, 8, 18, 0x230020001f001d001a00190016001300110010000e000b000a00070005000400020001⟩,
  ⟨39, 33, 163, ⟩,
  ⟨551, 46, 134, ⟩,
  ⟨1063, 56, 127, ⟩,
  ⟨1575, 64, 127, ⟩,
  ⟨2087, 72, 119, ⟩,
  ⟨2599, 78, 109, ⟩]
def segments : List Segment := segmentsPart0
def bits : Nat := 
theorem certifiedSource : PrimeBitmap 3 bits := by
  have h : sourceBits segments = bits := by decide +kernel
  exact h ▸ source_sound segments (by decide +kernel)
def fac : Nat := 0x1b30964ec395dc24069528d54bbda40d16e966ef9a70eb21b5b2943a321cdf10391745570cca9420c6ecb3b72ed2ee8b02ea2735c61a000000000000000000000000
theorem fac_eq : fac = Nat.factorial 100 := by decide +kernel
def rowsPart0 : List Row := [⟨2048, 21, 0x32002600230020001d001c00190016001400130011000e000d000a0008000700050004000200010000, 0x0⟩,
  ⟨2048, 25, 0x6c0060005e00550051004e004c004000370033002e002d002b00280027001f001e0018001300120010000f000900060001, 0x53d104145a853e7ef8f4e01cec305dd7333b34233bb4c8689893b10afa12bea64d4d8⟩,
  ⟨902, 23, 0x710062005f0052004d004c00460041003e003d003a003700320029002500230020001c001a0019000d00080002, 0xd0135c258f47d5c93f609f12eace79a716c62af126a988c52c27854a783c3906dc9ab318⟩]
def rows : List Row := rowsPart0
theorem binaryGoldbachUpTo : ∀ n : Nat, Even n → 4 ≤ n → n ≤ 10^4 →
    ∃ p q : Nat, p.Prime ∧ q.Prime ∧ p+q=n :=
  prefix_of_rows (halo := 1024) certifiedSource fac_eq rows (by decide +kernel) (by decide +kernel)
end SmallGoldbach.Power4
