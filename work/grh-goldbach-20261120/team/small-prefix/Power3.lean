def fac : Nat := 0x1956ad0aae33a4560c5cd2c000000
theorem fac_eq : fac = Nat.factorial 31 := by decide +kernel
def rowsPart0 : List Row := [⟨498, 13, 0x2300160014000e000d000a0008000700050004000200010000, 0x0⟩]
