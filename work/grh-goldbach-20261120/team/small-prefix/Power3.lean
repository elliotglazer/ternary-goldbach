theorem binaryGoldbachUpTo : ∀ n : Nat, Even n → 4 ≤ n → n ≤ 10^3 →
    ∃ p q : Nat, p.Prime ∧ q.Prime ∧ p+q=n :=
  prefix_of_rows (halo := 249) certifiedSource fac_eq rows (by decide +kernel) (by decide +kernel)
end SmallGoldbach.Power3
