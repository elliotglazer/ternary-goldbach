def bits : Nat := 0x2d841344b4084022480004c169960108264a0892110c009224b4026184c328244940928845005a05a04361821028a45244221128325841a4c90992120182514416894c308a25244b0902d021a6490cb4106c325261940b6894d325a65b7
theorem certifiedSource : PrimeBitmap 3 bits := by
  have h : sourceBits segments = bits := by decide +kernel
