import Mathlib.Data.Nat.Bitwise
import Lean.Elab.Tactic.Omega
import Mathlib.Data.Nat.Prime.Factorial
import Mathlib.Data.Nat.ModEq

namespace PrimeCoverage

/-- Every set bit denotes an odd-slot source value that is prime. -/
def PrimeBitmap (first bits : Nat) : Prop :=
  ∀ i, bits.testBit i = true → Nat.Prime (first + 2 * i)

theorem PrimeBitmap.zero (first : Nat) : PrimeBitmap first 0 := by
  intro i hi
  simp only [Nat.zero_testBit] at hi
  contradiction

theorem PrimeBitmap.singleton (first i : Nat) (hp : Nat.Prime (first + 2 * i)) :
    PrimeBitmap first (2 ^ i) := by
  intro j hj
  rw [Nat.testBit_two_pow] at hj
  have hij : i = j := of_decide_eq_true hj
  subst j
  exact hp

theorem PrimeBitmap.union {first a b : Nat}
    (ha : PrimeBitmap first a) (hb : PrimeBitmap first b) :
    PrimeBitmap first (a ||| b) := by
  intro j hj
  rw [Nat.testBit_or, Bool.or_eq_true] at hj
  rcases hj with h | h
  · exact ha j h
  · exact hb j h

/-- Shift a common source bitmap for each proposed anchor. -/
def shiftedUnion (bits : Nat) : List Nat → Nat
  | [] => 0
  | s :: ss => (bits >>> s) ||| shiftedUnion bits ss

theorem shiftedUnion_witness (bits : Nat) (ss : List Nat) (j : Nat)
    (h : (shiftedUnion bits ss).testBit j = true) :
    ∃ s ∈ ss, bits.testBit (s + j) = true := by
  induction ss with
  | nil =>
      simp only [shiftedUnion, Nat.zero_testBit] at h
      contradiction
  | cons s ss ih =>
      rw [shiftedUnion, Nat.testBit_or, Bool.or_eq_true] at h
      rcases h with h | h
      · exact ⟨s, List.mem_cons_self, by simpa only [Nat.testBit_shiftRight] using h⟩
      · obtain ⟨t, ht, hb⟩ := ih h
        exact ⟨t, List.mem_cons_of_mem s ht, hb⟩

/-- Binary Goldbach, with both summands proved prime. -/
def BinaryGoldbach (n : Nat) : Prop :=
  ∃ p q : Nat, p.Prime ∧ q.Prime ∧ p + q = n

/-- The complete semantic interface for a finite shifted-prime bitmap cover. -/
theorem binaryGoldbach_of_bitmap
    (first bits target width : Nat) (ss : List Nat)
    (hsource : PrimeBitmap first bits)
    (hanchors : ∀ s ∈ ss, (target - (first + 2 * s)).Prime ∧ first + 2 * s ≤ target)
    (hcover : (shiftedUnion bits ss &&& (2 ^ width - 1)) = 2 ^ width - 1) :
    ∀ j < width, BinaryGoldbach (target + 2 * j) := by
  intro j hj
  have h := congrArg (fun n : Nat => n.testBit j) hcover
  rw [Nat.testBit_and, Nat.testBit_two_pow_sub_one] at h
  simp only [hj, decide_true, Bool.and_true] at h
  obtain ⟨s, hs, hb⟩ := shiftedUnion_witness bits ss j h
  obtain ⟨hp, hle⟩ := hanchors s hs
  exact ⟨first + 2 * (s + j), target - (first + 2 * s), hsource _ hb, hp, by omega⟩

theorem binaryGoldbach_interval
    (target width : Nat) (heven : target % 2 = 0)
    (h : ∀ j < width, BinaryGoldbach (target + 2 * j)) :
    ∀ n, target ≤ n → n < target + 2 * width → n % 2 = 0 → BinaryGoldbach n := by
  intro n hlo hhi hn
  have hj : (n - target) / 2 < width := by omega
  have heq : target + 2 * ((n - target) / 2) = n := by omega
  exact heq ▸ h _ hj

end PrimeCoverage

namespace WideGoldbach
open PrimeCoverage

/-- Bit indices in one small-prime table chunk. -/
def marks : List Nat → Nat
  | [] => 0
  | i :: tail => (1 <<< i) ||| marks tail

def entries (first : Nat) (offsets : List Nat) : List Nat :=
  offsets.map fun i => first + 2 * i

private theorem member_dvd_prod {p : Nat} {xs : List Nat} (hp : p ∈ xs) : p ∣ xs.prod := by
  induction xs with
  | nil => simp at hp
  | cons a xs ih =>
    rw [List.mem_cons] at hp
    rw [List.prod_cons]
    rcases hp with rfl | h
    · exact dvd_mul_right _ _
    · exact dvd_mul_of_dvd_right (ih h) _

private theorem marks_sound (first : Nat) (is : List Nat)
    (hp : ∀ i ∈ is, Nat.Prime (first + 2 * i)) : PrimeBitmap first (marks is) := by
  induction is with
  | nil => exact PrimeBitmap.zero first
  | cons i tail ih =>
    apply PrimeBitmap.union
    · simpa only [Nat.shiftLeft_eq, Nat.one_mul] using
        PrimeBitmap.singleton first i (hp i List.mem_cons_self)
    · exact ih fun j hj => hp j (List.mem_cons_of_mem i hj)

/-- One gcd proves every proposed entry prime once its size is checked. -/
theorem table_chunk (first d : Nat) (is : List Nat)
    (hb : (entries first is).all (fun p => decide (1 < p ∧ p < (d+1)^2)) = true)
    (hc : Nat.Coprime (entries first is).prod d.factorial) :
    PrimeBitmap first (marks is) := by
  apply marks_sound
  intro i hi
  let p := first + 2 * i
  have hmem : p ∈ entries first is := List.mem_map.mpr ⟨i, hi, rfl⟩
  have hs := of_decide_eq_true ((List.all_eq_true.mp hb) _ hmem)
  have hcp := Nat.Coprime.of_dvd_left (member_dvd_prod hmem) hc
  have hm : d < p.minFac := (Nat.coprime_factorial_iff (by omega : p ≠ 1)).mp hcp
  by_contra hn
  have hsq := Nat.minFac_sq_le_self (by omega : 0 < p) hn
  have hlow : (d + 1)^2 ≤ p.minFac ^ 2 := Nat.pow_le_pow_left hm 2
  omega

theorem shift_chunk (first offset bits : Nat)
    (h : PrimeBitmap (first + 2*offset) bits) :
    PrimeBitmap first (bits <<< offset) := by
  intro j hj
  rw [Nat.testBit_shiftLeft, Bool.and_eq_true, decide_eq_true_eq] at hj
  have hp := h (j-offset) hj.2
  have heq : first + 2 * offset + 2 * (j - offset) = first + 2*j := by omega
  exact heq ▸ hp

end WideGoldbach

namespace SmallGoldbach
open PrimeCoverage WideGoldbach

theorem splitAnd {x y : Bool} (h : (x && y) = true) : x = true ∧ y = true := by
  simpa only [Bool.and_eq_true] using h

/-- Decode fixed-width unsigned offsets, starting with the least significant digit. -/
def unpack : Nat → Nat → List Nat
  | 0, _ => []
  | k+1, code => code % 65536 :: unpack k (code >>> 16)

private theorem marks_member {ss : List Nat} {s : Nat} (h : s ∈ ss) :
    (marks ss).testBit s = true := by
  induction ss with
  | nil => simp at h
  | cons a rest ih =>
    rw [marks, Nat.testBit_or, Bool.or_eq_true]
    rcases List.mem_cons.mp h with rfl | hm
    · left
      simp [Nat.testBit_shiftLeft]
    · exact Or.inr (ih hm)

/-- Translate a shared set of source primes once for each anchor offset. -/
def translates (bits : Nat) : List Nat → Nat
  | [] => 0
  | s :: ss => (bits <<< s) ||| translates bits ss

private theorem translates_witness (bits : Nat) (ss : List Nat) (j : Nat)
    (h : (translates bits ss).testBit j = true) :
    ∃ s ∈ ss, s ≤ j ∧ bits.testBit (j-s) = true := by
  induction ss with
  | nil => simp [translates] at h
  | cons s rest ih =>
    rw [translates, Nat.testBit_or, Bool.or_eq_true] at h
    rcases h with h | h
    · rw [Nat.testBit_shiftLeft, Bool.and_eq_true, decide_eq_true_eq] at h
      exact ⟨s, List.mem_cons_self, h.1, h.2⟩
    · obtain ⟨u, hu, hj⟩ := ih h
      exact ⟨u, List.mem_cons_of_mem _ hu, hj⟩

/-- The source and anchor numbers are both odd. Column zero denotes their base sum. -/
private theorem tile {bits a skip width : Nat} {ss : List Nat}
    (hs : PrimeBitmap 3 bits) (ha : ∀ s ∈ ss, (a+2*s).Prime)
    (hc : ((translates bits ss >>> skip) &&& (2^width-1)) = 2^width-1) :
    ∀ j < width, BinaryGoldbach (3+a+2*skip+2*j) := by
  intro j hj
  have ht := congrArg (fun v : Nat => v.testBit j) hc
  rw [Nat.testBit_and, Nat.testBit_two_pow_sub_one] at ht
  simp only [hj, decide_true, Bool.and_true, Nat.testBit_shiftRight] at ht
  obtain ⟨s, hmem, hle, hp⟩ := translates_witness _ _ _ ht
  exact ⟨3+2*(skip+j-s), a+2*s, hs _ hp, ha s hmem, by omega⟩

/-- A producer supplies the width, number of offsets, packed offsets, and a modular inverse. -/
structure Row where
  width : Nat
  count : Nat
  code : Nat
  inv : Nat

def skipAt (halo origin : Nat) := min halo ((origin-6)/2)
def baseAt (halo origin : Nat) := origin-3-2*skipAt halo origin

def checkRow (bits fac d halo origin : Nat) (r : Row) : Bool :=
  let ss := unpack r.count r.code
  let a := baseAt halo origin
  let ps := entries a ss
  let primeCheck := if a = 3 then ss.all (fun s => bits.testBit s) else
    ps.all (fun p => decide (1 < p ∧ p < (d+1)^2)) &&
    decide (fac * r.inv % ps.prod = 1 % ps.prod)
  primeCheck && decide (((translates bits ss >>> skipAt halo origin) &&& (2^r.width-1)) = 2^r.width-1)

private theorem row_sound {bits fac d halo origin : Nat} (r : Row)
    (hs : PrimeBitmap 3 bits) (hf : fac = d.factorial) (ho : 6 ≤ origin)
    (he : origin % 2 = 0) (hc : checkRow bits fac d halo origin r = true) :
    ∀ n, origin ≤ n → n < origin+2*r.width → n % 2 = 0 → BinaryGoldbach n := by
  let ss := unpack r.count r.code
  let a := baseAt halo origin
  have ha : ∀ s ∈ ss, (a+2*s).Prime := by
    have hp := (splitAnd hc).1
    change (if a = 3 then ss.all (fun s => bits.testBit s) else _) = true at hp
    split at hp
    · rename_i h
      intro s hm
      rw [h]
      exact hs s (List.all_eq_true.mp hp s hm)
    · obtain ⟨hb, hi⟩ := splitAnd hp
      have hg := Nat.coprime_of_mul_modEq_one r.inv (a := fac) (n := (entries a ss).prod)
        (of_decide_eq_true hi)
      have ht := table_chunk a d ss hb (by simpa only [hf] using hg.symm)
      exact fun s hm => ht s (marks_member hm)
  have ht := tile (width := r.width) (skip := skipAt halo origin) hs ha (of_decide_eq_true (splitAnd hc).2)
  have hskip : skipAt halo origin ≤ (origin-6)/2 := Nat.min_le_right _ _
  have eq : 3+a+2*skipAt halo origin = origin := by dsimp [a, baseAt]; omega
  rw [eq] at ht
  exact binaryGoldbach_interval _ _ he ht

def span : List Row → Nat
  | [] => 0
  | r :: rs => r.width + span rs

def checkRows (bits fac d halo : Nat) : Nat → List Row → Bool
  | _, [] => true
  | origin, r :: rs =>
    checkRow bits fac d halo origin r && checkRows bits fac d halo (origin+2*r.width) rs

theorem rows_sound {bits fac d halo : Nat} (hs : PrimeBitmap 3 bits) (hf : fac = d.factorial)
    (rs : List Row) (origin : Nat) (ho : 6 ≤ origin) (he : origin % 2 = 0)
    (hc : checkRows bits fac d halo origin rs = true) :
    ∀ n, origin ≤ n → n < origin+2*span rs → n % 2 = 0 → BinaryGoldbach n := by
  induction rs generalizing origin with
  | nil =>
    intro n hlo hhi
    simp [span] at hhi
    omega
  | cons r rs ih =>
    obtain ⟨hr, hrest⟩ := splitAnd hc
    intro n hlo hhi hn
    simp only [span] at hhi
    by_cases h : n < origin+2*r.width
    · exact row_sound r hs hf ho he hr n hlo h hn
    · exact ih _ (by omega) (by omega) hrest n (by omega) (by omega) hn

theorem prefix_of_rows {bits fac d halo bound : Nat} (hs : PrimeBitmap 3 bits)
    (hf : fac = d.factorial) (rs : List Row) (hc : checkRows bits fac d halo 6 rs = true)
    (hwidth : bound < 6+2*span rs) :
    ∀ n : Nat, Even n → 4 ≤ n → n ≤ bound → ∃ p q : Nat, p.Prime ∧ q.Prime ∧ p+q=n := by
  intro n he h4 hbound
  obtain ⟨k, hk⟩ := he
  by_cases h : n = 4
  · exact ⟨2, 2, Nat.prime_two, Nat.prime_two, by omega⟩
  · exact rows_sound hs hf rs 6 (by decide) (by decide) hc n (by omega) (by omega) (by omega)

end SmallGoldbach

namespace SmallGoldbach
open WideGoldbach PrimeCoverage

/-- One small-prime table segment. Its offset is measured from the odd number three. -/
structure Segment where
  start : Nat
  cutoff : Nat
  count : Nat
  code : Nat

def segmentBits (s : Segment) := marks (unpack s.count s.code)

def segmentOK (s : Segment) : Bool :=
  let ps := entries (3+2*s.start) (unpack s.count s.code)
  ps.all (fun p => decide (1 < p ∧ p < (s.cutoff+1)^2)) &&
    decide (Nat.Coprime ps.prod s.cutoff.factorial)

def sourceBits : List Segment → Nat
  | [] => 0
  | s::ss => (segmentBits s <<< s.start) ||| sourceBits ss

theorem source_sound (ss : List Segment) (hc : ss.all segmentOK = true) :
    PrimeBitmap 3 (sourceBits ss) := by
  induction ss with
  | nil => exact PrimeBitmap.zero _
  | cons s rest ih =>
    obtain ⟨h, hr⟩ := splitAnd hc
    obtain ⟨hb, hp⟩ := splitAnd h
    exact PrimeBitmap.union (shift_chunk 3 s.start _ (table_chunk _ s.cutoff _ hb (of_decide_eq_true hp))) (ih hr)

end SmallGoldbach

