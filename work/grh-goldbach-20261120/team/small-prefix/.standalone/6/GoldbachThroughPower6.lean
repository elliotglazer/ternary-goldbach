def rows : List Row := rowsPart0 ++ rowsPart1 ++ rowsPart2 ++ rowsPart3
theorem binaryGoldbachUpTo : ∀ n : Nat, Even n → 4 ≤ n → n ≤ 10^6 →
    ∃ p q : Nat, p.Prime ∧ q.Prime ∧ p+q=n :=
  prefix_of_rows (halo := 1024) certifiedSource fac_eq rows (by decide +kernel) (by decide +kernel)
end SmallGoldbach.Power6

namespace SmallGoldbach.Power6

theorem binaryGoldbachUpToPower {k : Nat} (hk : k ≤ 6) :
    ∀ n : Nat, Even n → 4 ≤ n → n ≤ 10^k →
      ∃ p q : Nat, p.Prime ∧ q.Prime ∧ p + q = n := by
  intro n he h4 hn
  exact binaryGoldbachUpTo n he h4
    (hn.trans (Nat.pow_le_pow_right (n := 10) (by decide) hk))

end SmallGoldbach.Power6
