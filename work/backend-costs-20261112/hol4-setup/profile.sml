     print ("HOL4_TAG," ^ label ^ ",oracles=" ^
            String.concatWith ";" oracles ^ ",axioms=" ^
            String.concatWith ";" axioms ^ "\n") end;
fun check_true tm =
  let val result = cv_eval tm
