SOURCE_EXP_HORNER_AXIOMS,bool.SELECT_AX;bool.INFINITY_AX;bool.ETA_AX;bool.BOOL_CASES_AX
SOURCE_EXP_HORNER_TYPE,source_exp_horner,:num -> int -> num -> num -> num -> int # int
SOURCE_EXP_HORNER_TYPE,source_exp_step,:num -> int -> num -> num -> int # int -> int # int
SOURCE_EXP_HORNER_TYPE,seh_affine,:real -> real -> real # real -> real # real
SOURCE_EXP_HORNER_TYPE,seh_ideal,:real -> num -> num -> real # real
SOURCE_EXP_HORNER_TYPE,seh_bound,:num -> real
SOURCE_EXP_HORNER_ROOT,seh_round_pair_error,⊢ ∀s r t.
    0 < s ⇒
    modu
      (pair_value 1 (round_scaled s r,round_scaled s t) − pair_value s (r,t)) ≤
    1
SOURCE_EXP_HORNER_ROOT,seh_affine_distance,⊢ ∀a t u v. modu (seh_affine a t u − seh_affine a t v) = abs t * modu (u − v)
SOURCE_EXP_HORNER_ROOT,seh_affine_scale,⊢ ∀a t z. seh_affine a t (a * z) = a * seh_affine 1 t z
SOURCE_EXP_HORNER_ROOT,seh_den_positive,⊢ ∀d k. 0 < d ⇒ 0 < &d * &(k + 1)
SOURCE_EXP_HORNER_ROOT,seh_exact_affine,⊢ ∀grid d k p u.
    0 < d ⇒
    seh_affine (&grid) (real_of_int p / &d / &(k + 1)) (pair_value 1 u) =
    pair_value (&d * &(k + 1))
      (&grid * (&d * &(k + 1)) − p * SND u,p * FST u)
SOURCE_EXP_HORNER_ROOT,seh_actual_step_error,⊢ ∀grid d k p u.
    0 < d ⇒
    modu
      (pair_value 1 (source_exp_step grid p d k u) −
       seh_affine (&grid) (real_of_int p / &d / &(k + 1)) (pair_value 1 u)) ≤
    1
SOURCE_EXP_HORNER_ROOT,seh_update_error,⊢ ∀a t eps z u v.
    modu (z − seh_affine a t u) ≤ 1 ∧ modu (u − v) ≤ eps ⇒
    modu (z − seh_affine a t v) ≤ 1 + abs t * eps
SOURCE_EXP_HORNER_ROOT,seh_bound_nonnegative,⊢ ∀k. 0 ≤ seh_bound k
SOURCE_EXP_HORNER_ROOT,seh_bound_step,⊢ ∀k phase.
    abs phase ≤ 2 ⇒
    1 + abs (phase / &(k + 1)) * seh_bound (SUC k) ≤ seh_bound k
SOURCE_EXP_HORNER_ROOT,seh_initial_exact,⊢ ∀grid k phase. pair_value 1 (&grid,0) = &grid * seh_ideal phase 0 k
SOURCE_EXP_HORNER_ROOT,source_exp_horner_error,⊢ ∀grid d p.
    0 < d ∧ abs (real_of_int p / &d) ≤ 2 ⇒
    ∀n k.
      modu
        (pair_value 1 (source_exp_horner grid p d n k) −
         &grid * seh_ideal (real_of_int p / &d) n k) ≤ seh_bound k
SOURCE_EXP_HORNER_ROOT,source_exp_horner_zero_error,⊢ ∀grid d p.
    0 < d ∧ abs (real_of_int p / &d) ≤ 2 ⇒
    ∀n. modu
          (pair_value 1 (source_exp_horner grid p d n 0) −
           &grid * seh_ideal (real_of_int p / &d) n 0) ≤ 9
SOURCE_EXP_HORNER_EXACT_AUDIT_DONE
