SOURCE_THEOREM,source_initial_def,oracles=DISK_THM,axiom_tags=,⊢ ∀A D amplitude_bits state_bits.
    source_initial A D amplitude_bits state_bits =
    if 0 < D ∧ D ≤ A ∧ amplitude_bits ≤ state_bits then
      SOME
        (&source_inverse_root A D (2 ** amplitude_bits) *
         &(2 ** (state_bits − amplitude_bits)),0)
    else NONE
SOURCE_THEOREM,source_log_checked_domain,oracles=DISK_THM,axiom_tags=,⊢ ∀S n out_div l2 k A D q.
    source_log_checked S n out_div l2 k A D = SOME q ⇒
    0 < S ∧ 0 < out_div ∧ source_log_domain A D k
SOURCE_THEOREM,source_pool_tick_length,oracles=DISK_THM,axiom_tags=,⊢ ∀step_scale entries.
    LENGTH (source_pool_tick step_scale entries) = LENGTH entries
SOURCE_THEOREM,source_mul_residuals,oracles=DISK_THM,axiom_tags=,⊢ ∀step_scale ur ui vr vi.
    0 < &step_scale ⇒
    -&step_scale ≤
    2 *
    (ur * vr − ui * vi −
     FST (source_mul step_scale (ur,ui) (vr,vi)) * &step_scale) ∧
    2 *
    (ur * vr − ui * vi −
     FST (source_mul step_scale (ur,ui) (vr,vi)) * &step_scale) < &step_scale ∧
    -&step_scale ≤
    2 *
    (ur * vi + ui * vr −
     SND (source_mul step_scale (ur,ui) (vr,vi)) * &step_scale) ∧
    2 *
    (ur * vi + ui * vr −
     SND (source_mul step_scale (ur,ui) (vr,vi)) * &step_scale) < &step_scale
