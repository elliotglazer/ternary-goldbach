weighted_upper oracles=DISK_THM ⊢ ∀main top g e xs A.
    main < top ∧
    EVERY (λx. g x ≤ top ∧ ∀r. e x = SOME r ⇒ main < g x ∧ g x ≤ r ∧ r ≤ top)
      xs ∧ weighted (λx. if g x ≤ main then top − main else top − g x) xs ≤ A ⇒
    &low main g xs ≤ (A − weighted (λx. credit top (e x)) xs) / (top − main)
weighted_lower oracles=DISK_THM ⊢ ∀main top g e xs.
