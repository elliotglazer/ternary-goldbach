open HolKernel Parse boolLib bossLib StageCheckTheory DependentBlockTheory cv_transLib;
fun require condition message = if condition then () else raise Fail message;
val _ = new_theory "PreparedDependentResults";
val context_axioms = List.concat (map (fn theory =>
  map (fn (name,_) => theory ^ "." ^ name) (DB.axioms theory))
  ("DependentBlock" :: Theory.ancestry "DependentBlock"));
(* These are HOL4's four upstream bool-theory axioms. This audit does not
   claim that they are Lean's three axioms or an already translated result. *)
val allowed_axioms = ["bool.ETA_AX","bool.SELECT_AX","bool.INFINITY_AX",
                      "bool.BOOL_CASES_AX"];
val _ = print ("HOL4_CONTEXT_AXIOMS," ^
  String.concatWith ";" context_axioms ^ "\n");
val _ = require (List.all (fn name => List.exists (fn a => a = name)
  allowed_axioms) context_axioms) "unexpected context axiom";
fun timed label work =
  let val cpu = Timer.startCPUTimer ()
      val wall = Time.now ()
      val result = work ()
      val {usr,sys} = Timer.checkCPUTimer cpu
      val elapsed = Time.- (Time.now (),wall)
  in print ("HOL4_TIME," ^ label ^ "," ^
            Real.fmt (StringCvt.FIX (SOME 9)) (Time.toReal (Time.+ (usr,sys))) ^ "," ^
            Real.fmt (StringCvt.FIX (SOME 9)) (Time.toReal elapsed) ^ "\n"); result end;
fun audit label th =
  let val (oracles,axioms) = Tag.dest_tag (tag th)
  in require (null (hyp th)) "theorem has hypotheses";
     require (List.all (fn x => x = "DISK_THM") oracles)
             "unexpected oracle dependency";
     print ("HOL4_TAG," ^ label ^ ",oracles=" ^
            String.concatWith ";" oracles ^ ",axioms=" ^
            String.concatWith ";" axioms ^ "\n") end;
val preconditions = ref ([]:thm list);
fun normalize_result tm raw =
  let val result = SIMP_RULE bool_ss (!preconditions) raw
      val _ = if is_eq (concl result) orelse aconv (concl result) tm orelse
                 aconv (concl result) (mk_neg tm) then ()
              else print ("HOL4_UNCLOSED_RESULT," ^ thm_to_string result ^ "\n")
  in if aconv (concl result) tm then EQT_INTRO result
     else if aconv (concl result) (mk_neg tm) then EQF_INTRO result
     else result end;
val mode = case OS.Process.getEnv "PREPARED_MODE" of
  SOME s => s | NONE => raise Fail "PREPARED_MODE required";
val _ = require (List.exists (fn s => s = mode) ["stock","fresh","retained"])
                "bad PREPARED_MODE";
val _ = print ("PREPARED_MODE," ^ mode ^ "\n");
val active = ref (NONE : (string -> term -> thm) option);
val original_cache = ref (NONE : (string -> term -> thm) option);
fun set_case label tm =
  if mode = "retained" then
    let val f = timed (label ^ "_prebuild_total")
                     (fn () => PreparedEval.prepare label tm)
    in active := SOME f;
       if label = "depth8" then original_cache := SOME f else () end
  else timed (label ^ "_stock_or_fresh_metadata") (fn () =>
    let val (_,_,eqs) = PreparedEval.discover tm
    in PreparedEval.record_equations label eqs end);
fun selected_eval label tm =
  if mode = "stock" then cv_eval tm
  else if mode = "fresh" then PreparedEval.fresh label tm
  else case !active of SOME f => f label tm
       | NONE => raise Fail "missing prepared conversion";
fun check_result tm expected raw =
  let val result = normalize_result tm raw
  in require (aconv (lhs (concl result)) tm) "wrong checked input";
     require (aconv (rhs (concl result)) expected) "wrong boolean result";
     require (null (hyp result)) "unclosed result"; result end;
fun check_true tm = check_result tm boolSyntax.T (selected_eval "positive" tm);
fun check_false label tm =
  let
    val baseline = timed ("control_" ^ label ^ "_stock_reference")
       (fn () => check_result tm boolSyntax.F (cv_eval tm))
    val raw =
      if mode <> "retained" then selected_eval ("control_" ^ label) tm
      else
        case !original_cache of
          NONE => raise Fail "missing original control cache"
        | SOME f =>
            ((let val th = f ("control_" ^ label) tm
                   val _ = print ("PREPARED_CACHE_HIT," ^ label ^ "\n")
               in th end) handle PreparedEval.CacheMismatch =>
              let val _ = print ("PREPARED_CACHE_MISS," ^ label ^ "\n")
                  val g = timed ("control_" ^ label ^ "_new_prebuild_total")
                     (fn () => PreparedEval.prepare ("control_" ^ label) tm)
              in g ("control_" ^ label ^ "_new") tm end)
    val result = check_result tm boolSyntax.F raw
    val _ = require (aconv (concl baseline) (concl result)) "control mismatch"
  in audit label result;
     ignore (save_thm ("rejected_" ^ label,result));
     print ("HOL4_REJECTED_" ^ label ^ "\n") end;


fun int_term text =
  let val n = Arbint.fromString text
      val tm = intSyntax.term_of_int n
  in require (Arbint.toString (intSyntax.int_of_term tm) = Arbint.toString n)
       "integer construction failed round trip"; tm end;
fun row_term data = pairSyntax.list_mk_pair (map int_term data);
fun rows_term data =
  let val rows = map row_term data
  in listSyntax.mk_list (rows,type_of (hd rows)) end;


fun named name tm =
  let val def = new_definition (name ^ "_def",mk_eq (mk_var (name,type_of tm),tm))
      val _ = timed ("translate_" ^ name) (fn () => cv_trans def)
  in lhs (concl def) end;

