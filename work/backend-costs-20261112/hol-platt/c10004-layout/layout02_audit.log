C10004_LAYOUT_AXIOMS,bool.SELECT_AX;bool.INFINITY_AX;bool.ETA_AX;bool.BOOL_CASES_AX
C10004_LAYOUT_THEOREM,layout_checked,oracles=DISK_THM,axioms=,⊢ layout_finite_checks
C10004_LAYOUT_THEOREM,layout_old_properties,oracles=DISK_THM,axioms=,⊢ ∀i. i < 4800 ⇒ old_checks i
C10004_LAYOUT_THEOREM,layout_tensor_properties,oracles=DISK_THM,axioms=,⊢ ∀t. t < 4800 ⇒ tensor_checks t
C10004_LAYOUT_THEOREM,layout_exactly_once,oracles=DISK_THM,axioms=,⊢ ∀t. t < 4800 ⇒ ∃!i. i < 4800 ∧ old_to_tensor i = t
C10004_LAYOUT_THEOREM,layout_permutation,oracles=DISK_THM,axioms=,⊢ PERM (GENLIST old_to_tensor 4800) (GENLIST I 4800)
C10004_LAYOUT_THEOREM,layout_preserves_residue,oracles=DISK_THM,axioms=,⊢ ∀i. i < 4800 ⇒ tensor_residue (old_to_tensor i) = residue i
C10004_LAYOUT_THEOREM,tensor_source_residue,oracles=DISK_THM,axioms=,⊢ ∀t. t < 4800 ⇒ tensor_residue t = residue (tensor_to_old t)
C10004_LAYOUT_THEOREM,fine_cell_checked,oracles=DISK_THM,axioms=,⊢ ∀t. t < 4800 ⇒
      0 < tensor_residue t ∧ tensor_residue t < 10004 ∧
      fine_cell (tensor_residue t) ≤ 1024 ∧
      2 * fine_cell (tensor_residue t) * 10004 <
      2048 * tensor_residue t + 10004 ∧
      2048 * tensor_residue t ≤
      (2 * fine_cell (tensor_residue t) + 1) * 10004
C10004_LAYOUT_AUDIT_DONE_NO_CHARACTER_DFT_ANALYTICS
