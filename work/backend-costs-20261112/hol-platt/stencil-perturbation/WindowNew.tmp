Theory WindowPerturbation
Ancestors KernelPerturbation StencilPerturbation StencilReceipt GridSigns Enclosure KernelWeights integer list arithmetic sptree
Libs intLib

Definition raw_center_def:
  raw_center (x:num) = &x - &(2**255):int
End
Definition field_center_def:
  field_center (q:int,u:num) = q * &u
End
Definition reads_def:
  (reads tab j ([]:(int#num) list) <=> T) /\
  (reads tab j (p::ps) <=> lookup j tab = SOME p /\ reads tab (SUC j) ps)
End
Definition peak_def:
  (peak ([]:(int#num) list) = 0:num) /\
  (peak ((q,u)::ps) = MAX u (peak ps))
End

Theorem window_sum:
  !ws ps tab j a cap. LENGTH ws = LENGTH ps /\ reads tab j ps ==>
  GridSigns$dot_window tab j ws a cap =
    SOME (a + StencilReceipt$dot ws (MAP field_center ps), MAX cap (peak ps))
Proof
  Induct_on `ws` >- (Cases_on `ps` >> simp [GridSignsTheory.dot_window_def,StencilReceiptTheory.dot_def,peak_def]) >>
  rpt gen_tac >> Cases_on `ps` >> simp [] >>
  rename1 `reads tab j (p::ps')` >> PairCases_on `p` >>
  simp [reads_def,peak_def,field_center_def,GridSignsTheory.dot_window_def,StencilReceiptTheory.dot_def] >>
  rpt strip_tac >> simp [GridSignsTheory.dot_window_def] >>
  first_x_assum (qspecl_then [`ps'`,`tab`,`SUC j`,`a+h*p0* &p1`,`MAX cap p1`] mp_tac) >>
  simp [INT_ADD_ASSOC,INT_MUL_ASSOC,MAX_ASSOC]
QED

Theorem enclosed_coordinate:
  !x q u cap. Enclosure$encloses x (q,u) /\ u <= cap ==>
  ABS (raw_center x - field_center (q,u)) <= &cap
Proof
  rpt gen_tac >> simp [EnclosureTheory.encloses_def,raw_center_def,field_center_def,INT_ABS] >>
  rpt strip_tac >> intLib.ARITH_TAC
QED

Theorem bounded_fields:
  !raw ps cap. LIST_REL Enclosure$encloses raw ps /\ peak ps <= cap ==>
  LIST_REL (\x y. ABS (x-y) <= &cap) (MAP raw_center raw) (MAP field_center ps)
Proof
  Induct_on `raw` >> Cases_on `ps` >> simp [] >>
  rename1 `peak (p::ps')` >> PairCases_on `p` >>
  simp [peak_def,MAX_DEF] >> metis_tac [enclosed_coordinate,LESS_EQ_TRANS,NOT_LESS,LESS_IMP_LESS_OR_EQ]
QED

fun mark s g = (print ("WINDOW_STEP "^s^"\n");ALL_TAC g);
Theorem window_dot_error:
  !ws ps raw tab j z cap r off den.
  KernelWeights$kernel_ok r off (&den) ws /\ LENGTH ws = LENGTH ps /\
  reads tab j ps /\ LIST_REL Enclosure$encloses raw ps /\
  GridSigns$dot_window tab j ws 0 0 = SOME(z,cap) ==>
  ABS (StencilReceipt$dot ws (MAP raw_center raw) - z) <= &(5*den*cap)
Proof
  rpt strip_tac >>
  `GridSigns$dot_window tab j ws 0 0 = SOME(StencilReceipt$dot ws (MAP field_center ps),peak ps)`
    by (mp_tac (Q.SPECL [`ws`,`ps`,`tab`,`j`,`0:int`,`0:num`] window_sum) >> simp []) >> mark "eq" >>
  fs [] >> mark "subst" >>
  `LENGTH (MAP raw_center raw) = LENGTH ws` by metis_tac [LIST_REL_LENGTH,LENGTH_MAP] >> mark "length" >>
  `LIST_REL (\x y. ABS (x-y) <= &(peak ps)) (MAP raw_center raw) (MAP field_center ps)`
    by metis_tac [bounded_fields,LESS_EQ_REFL] >> mark "fields" >>
  mp_tac (Q.SPECL [`r`,`off`,`&den:int`,`ws`,`MAP raw_center raw`,`MAP field_center ps`,`&(peak ps):int`] kernel_ok_dot_perturbation) >>
  simp [INT_MUL]
QED

Theorem window_sign_margin:
  !ws ps raw tab j z cap r off den err.
  KernelWeights$kernel_ok r off (&den) ws /\ LENGTH ws = LENGTH ps /\
  reads tab j ps /\ LIST_REL Enclosure$encloses raw ps /\
  GridSigns$dot_window tab j ws 0 0 = SOME(z,cap) ==>
  let v=StencilReceipt$dot ws (MAP raw_center raw) in
  (GridSigns$strict_code z (den*(err+5*cap)) = 2 ==> &(den*err)<v) /\
  (GridSigns$strict_code z (den*(err+5*cap)) = 1 ==> v < -&(den*err))
Proof
  rpt gen_tac >> strip_tac >>
  `ABS (StencilReceipt$dot ws (MAP raw_center raw) - z) <= &(5*den*cap)` by
    (MATCH_MP_TAC (Q.SPECL [`ws`,`ps`,`raw`,`tab`,`j`,`z`,`cap`,`r`,`off`,`den`] window_dot_error) >> ASM_REWRITE_TAC []) >>
  `den*(err+5*cap) = den*err + (5*den*cap)` by
    (REWRITE_TAC [LEFT_ADD_DISTRIB] >> AP_TERM_TAC >> CONV_TAC (AC_CONV (MULT_ASSOC,MULT_COMM))) >>
  ASM_REWRITE_TAC [LET_THM] >>
  MATCH_MP_TAC (Q.SPECL [`z:int`,`StencilReceipt$dot ws (MAP raw_center raw)`,`5*den*cap:num`,`den*err:num`] GridSignsTheory.coarse_interval_margin) >>
  ASM_REWRITE_TAC []
QED
