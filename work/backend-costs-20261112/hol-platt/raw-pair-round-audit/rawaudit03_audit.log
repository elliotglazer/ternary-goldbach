RAW_PAIR_ROOT,round_scaled_real_residual,⊢ ∀s r.
    0 < s ⇒
    abs (real_of_int r − real_of_int (round_scaled s r) * real_of_int s) ≤
    real_of_int s / 2
RAW_PAIR_ROOT,round_scaled_real_error,⊢ ∀s r.
    0 < s ⇒
    abs (real_of_int (round_scaled s r) − real_of_int r / real_of_int s) ≤
    1 / 2
RAW_PAIR_ROOT,round_scaled_coordinate_error,⊢ ∀g s r.
    0 < g ∧ 0 < s ⇒
    abs
      (real_of_int (round_scaled s r) / real_of_int g −
       real_of_int r / (real_of_int s * real_of_int g)) ≤
    1 / (2 * real_of_int g)
RAW_PAIR_ROOT,modu_le_coordinate_sum,⊢ ∀z. modu z ≤ abs (RE z) + abs (IM z)
RAW_PAIR_ROOT,pair_value_exact_product,⊢ ∀g s ur ui wr wi.
    0 < g ∧ 0 < s ⇒
    pair_value g (ur,ui) * pair_value s (wr,wi) =
    pair_value (s * g) (ur * wr − ui * wi,ur * wi + ui * wr)
RAW_PAIR_ROOT,four_product_coordinate_errors,⊢ ∀g s ur ui wr wi.
    0 < g ∧ 0 < s ⇒
    abs
      (RE
         (pair_value g (four_product_round s (ur,ui) (wr,wi)) −
          pair_value g (ur,ui) * pair_value s (wr,wi))) ≤
    1 / (2 * real_of_int g) ∧
    abs
      (IM
         (pair_value g (four_product_round s (ur,ui) (wr,wi)) −
          pair_value g (ur,ui) * pair_value s (wr,wi))) ≤
    1 / (2 * real_of_int g)
RAW_PAIR_ROOT,four_product_round_error,⊢ ∀g s ur ui wr wi.
    0 < g ∧ 0 < s ⇒
    modu
      (pair_value g (four_product_round s (ur,ui) (wr,wi)) −
       pair_value g (ur,ui) * pair_value s (wr,wi)) ≤ 1 / real_of_int g
