TRAVERSAL_AXIOMS,bool.SELECT_AX;bool.INFINITY_AX;bool.ETA_AX;bool.BOOL_CASES_AX
TRAVERSAL_THEOREM,ft_take_spec,oracles=DISK_THM,axioms=,⊢ ∀n xs.
    ft_take n xs = if n ≤ LENGTH xs then SOME (TAKE n xs,DROP n xs) else NONE
TRAVERSAL_THEOREM,ft_pairs_genlist,oracles=DISK_THM,axioms=,⊢ ∀n f.
    ft_pairs (GENLIST f (2 * n)) =
    SOME (GENLIST (λj. tx_sub (f (2 * j)) (f (2 * j + 1))) n)
TRAVERSAL_THEOREM,ft_chunks_genlist,oracles=DISK_THM,axioms=,⊢ ∀n width f.
    ft_chunks n width (GENLIST f (n * width)) =
    SOME (GENLIST (λi. GENLIST (λj. f (width * i + j)) width) n)
TRAVERSAL_THEOREM,ft_heads_tails_genlist,oracles=DISK_THM,axioms=,⊢ ∀n columns f.
    ft_heads_tails (GENLIST (λi. GENLIST (f i) (SUC columns)) n) =
    SOME
      (GENLIST (λi. f i 0) n,
       GENLIST (λi. GENLIST (λj. f i (SUC j)) columns) n)
TRAVERSAL_THEOREM,ft_transpose_genlist,oracles=DISK_THM,axioms=,⊢ ∀columns n f.
    ft_transpose columns (GENLIST (λi. GENLIST (f i) columns) n) =
    SOME (GENLIST (λj. GENLIST (λi. f i j) n) columns)
TRAVERSAL_THEOREM,ft_concat_flat,oracles=DISK_THM,axioms=,⊢ ∀rows. ft_concat rows = FLAT rows
TRAVERSAL_THEOREM,ft_concat_blocks,oracles=DISK_THM,axioms=,⊢ ∀n width f.
    ft_concat (GENLIST (λi. GENLIST (λj. f (width * i + j)) width) n) =
    GENLIST f (n * width)
