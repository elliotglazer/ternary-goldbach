SOURCE_LOG_HORNER_AXIOMS,bool.SELECT_AX;bool.INFINITY_AX;bool.ETA_AX;bool.BOOL_CASES_AX
SOURCE_LOG_HORNER_TYPE,source_log_horner,:num -> num -> num -> num -> num -> int
SOURCE_LOG_HORNER_TYPE,source_log_center,:num -> num -> num -> num -> int
SOURCE_LOG_HORNER_TYPE,slh_ideal,:real -> num -> num -> real
SOURCE_LOG_HORNER_ROOT,slh_ideal_append,⊢ ∀n k v.
    slh_ideal v (SUC n) k =
    slh_ideal v n k + v pow (2 * n) / &(2 * (k + n) + 1)
SOURCE_LOG_HORNER_ROOT,slh_partial_eq_ideal,⊢ ∀n v. sl_log_partial n v = 2 * v * slh_ideal v n 0
SOURCE_LOG_HORNER_ROOT,slh_ratio_range,⊢ ∀A B.
    0 < B ∧ 3 * A ≤ B ⇒
    0 ≤ &A / &B ∧ &A / &B ≤ 1 / 3 ∧ 0 ≤ (&A / &B)² ∧ (&A / &B)² ≤ 1 / 9
SOURCE_LOG_HORNER_ROOT,slh_nat_square_real,⊢ ∀A. real_of_int (&A ** 2) = (&A)²
SOURCE_LOG_HORNER_ROOT,slh_den_positive,⊢ ∀B k. 0 < B ⇒ 0 < &(2 * k + 1) * &B ** 2
SOURCE_LOG_HORNER_ROOT,slh_unrounded_value,⊢ ∀grid A B k w.
    0 < B ⇒
    real_of_int (&grid * &B ** 2 + &(2 * k + 1) * &A ** 2 * w) /
    real_of_int (&(2 * k + 1) * &B ** 2) =
    &grid / &(2 * k + 1) + (&A / &B)² * real_of_int w
SOURCE_LOG_HORNER_ROOT,slh_actual_step_error,⊢ ∀grid A B n k.
    0 < B ⇒
    abs
      (real_of_int (source_log_horner grid A B (SUC n) k) −
       (&grid / &(2 * k + 1) +
        (&A / &B)² * real_of_int (source_log_horner grid A B n (SUC k)))) ≤
    1 / 2
SOURCE_LOG_HORNER_ROOT,slh_affine_contraction,⊢ ∀a b c u h.
    0 ≤ c ∧ c ≤ 1 / 9 ∧ abs (u − h) ≤ 1 ∧ abs (a − (b + c * u)) ≤ 1 / 2 ⇒
    abs (a − (b + c * h)) ≤ 1
SOURCE_LOG_HORNER_ROOT,source_log_horner_error,⊢ ∀grid A B.
    0 < B ∧ 3 * A ≤ B ⇒
    ∀n k.
      abs
        (real_of_int (source_log_horner grid A B n k) −
         &grid * slh_ideal (&A / &B) n k) ≤ 1
SOURCE_LOG_HORNER_ROOT,slh_center_unscaled_error,⊢ ∀grid A B n.
    0 < B ∧ 3 * A ≤ B ⇒
    abs
      (real_of_int (source_log_center grid A B n) −
       &grid * sl_log_partial n (&A / &B)) ≤ 7 / 4
SOURCE_LOG_HORNER_ROOT,source_log_center_error,⊢ ∀grid A B n.
    0 < grid ∧ 0 < B ∧ 3 * A ≤ B ⇒
    abs
      (real_of_int (source_log_center grid A B n) / &grid −
       sl_log_partial n (&A / &B)) ≤ 7 / (4 * &grid)
SOURCE_LOG_HORNER_ROOT,source_log_center45_error,⊢ ∀grid A B.
    0 < grid ∧ 0 < B ∧ 3 * A ≤ B ⇒
    abs
      (real_of_int (source_log_center grid A B 45) / &grid −
       ln ((1 + &A / &B) / (1 − &A / &B))) ≤ 7 / (4 * &grid) + 1 / 2 pow 135
SOURCE_LOG_HORNER_ROOT,source_log_two45_error,⊢ ∀grid.
    0 < grid ⇒
    abs (real_of_int (source_log_center grid 1 3 45) / &grid − ln 2) ≤
    7 / (4 * &grid) + 1 / 2 pow 135
SOURCE_LOG_HORNER_EXACT_AUDIT_DONE
