import "arithmetic.mm1";
-- Finite rule table: every entry has a PA proof.
theorem paFour00 (a b c: nat) (h: $ a + b = c $): $ (b0 (b0 (b0 (b0 a)))) + (b0 (b0 (b0 (b0 b)))) = (b0 (b0 (b0 (b0 c)))) $ = '(paAdd00 (paAdd00 (paAdd00 (paAdd00 h))));
