import "arithmetic.mm1";
def A0: nat = $ 0 $;
def B0: nat = $ (b1 ( b0 ( b1 (0)))) $;
def C0: nat = $ 0 $;
pub theorem product0: $ A0 * B0 = C0 $ = 'mul01;
def A1: nat = $ (b1 ( b1 ( b1 (0)))) $;
def B1: nat = $ 0 $;
def C1: nat = $ 0 $;
pub theorem product1: $ A1 * B1 = C1 $ = 'mul0;
def A2: nat = $ (b1 ( b1 ( b1 (0)))) $;
def B2: nat = $ (b1 (0)) $;
def C2: nat = $ (b1 ( b1 ( b1 (0)))) $;
pub theorem product2: $ A2 * B2 = C2 $ = 'paMulOne;
def A3: nat = $ (b0 ( b1 (0))) $;
def B3: nat = $ (b1 ( b1 (0))) $;
def C3: nat = $ (b0 ( b1 ( b1 (0)))) $;
pub theorem product3: $ A3 * B3 = C3 $ = '(paMulOdd paMulOne (paAdd00 (paAdd01 add0)));
def A4: nat = $ (b1 ( b1 (0))) $;
def B4: nat = $ (b1 ( b1 (0))) $;
def C4: nat = $ (b1 ( b0 ( b0 ( b1 (0))))) $;
pub theorem product4: $ A4 * B4 = C4 $ = '(paMulOdd paMulOne (paAdd01 (paAdd11 add0 (paSuccOdd paSuccZero))));
def A5: nat = $ (b1 ( b1 ( b1 (0)))) $;
def B5: nat = $ (b1 ( b1 ( b1 (0)))) $;
def C5: nat = $ (b1 ( b0 ( b0 ( b0 ( b1 ( b1 (0))))))) $;
pub theorem product5: $ A5 * B5 = C5 $ = '(paMulOdd (paMulOdd paMulOne (paAdd01 (paAdd11 (paAdd11 add0 (paSuccOdd paSuccZero)) sucb0))) (paAdd01 (paAdd11 (paAdd01 add0) (paSuccOdd (paSuccOdd sucb0)))));
def A6: nat = $ (b1 ( b0 ( b0 ( b0 ( b1 (0)))))) $;
def B6: nat = $ (b0 ( b1 ( b0 ( b0 ( b1 (0)))))) $;
def C6: nat = $ (b0 ( b1 ( b0 ( b0 ( b1 ( b1 ( b0 ( b0 ( b1 (0)))))))))) $;
pub theorem product6: $ A6 * B6 = C6 $ = '(paMulEven (paMulOdd (paMulEven (paMulEven paMulOne)) (paAdd01 (paAdd00 (paAdd00 (paAdd10 (paAdd01 add0)))))));
def A7: nat = $ (b1 ( b1 ( b1 ( b1 ( b1 ( b1 ( b1 (0)))))))) $;
def B7: nat = $ (b1 ( b1 ( b1 ( b1 ( b1 ( b1 ( b1 ( b1 (0))))))))) $;
def C7: nat = $ (b1 ( b0 ( b0 ( b0 ( b0 ( b0 ( b0 ( b1 ( b0 ( b1 ( b1 ( b1 ( b1 ( b1 ( b1 (0)))))))))))))))) $;
pub theorem product7: $ A7 * B7 = C7 $ = '(paMulOdd (paMulOdd (paMulOdd (paMulOdd (paMulOdd (paMulOdd (paMulOdd paMulOne (paAdd01 (paAdd11 (paAdd11 (paAdd11 (paAdd11 (paAdd11 (paAdd11 add0 (paSuccOdd paSuccZero)) sucb0) sucb0) sucb0) sucb0) sucb0))) (paAdd01 (paAdd11 (paAdd01 (paAdd11 (paAdd11 (paAdd11 (paAdd11 add0 (paSuccOdd sucb0)) sucb0) sucb0) sucb0)) (paSuccOdd sucb0)))) (paAdd01 (paAdd11 (paAdd01 (paAdd01 (paAdd11 (paAdd11 (paAdd11 add0 (paSuccOdd sucb0)) sucb0) sucb0))) (paSuccOdd (paSuccOdd sucb0))))) (paAdd01 (paAdd11 (paAdd01 (paAdd01 (paAdd01 (paAdd11 (paAdd11 add0 (paSuccOdd sucb0)) sucb0)))) (paSuccOdd (paSuccOdd (paSuccOdd sucb0)))))) (paAdd01 (paAdd11 (paAdd01 (paAdd01 (paAdd01 (paAdd01 (paAdd11 add0 (paSuccOdd sucb0)))))) (paSuccOdd (paSuccOdd (paSuccOdd (paSuccOdd sucb0))))))) (paAdd01 (paAdd11 (paAdd01 (paAdd01 (paAdd01 (paAdd01 (paAdd01 add0))))) (paSuccOdd (paSuccOdd (paSuccOdd (paSuccOdd (paSuccOdd (paSuccOdd sucb0))))))))) (paAdd01 (paAdd11 (paAdd01 (paAdd01 (paAdd01 (paAdd01 (paAdd01 add0))))) (paSuccOdd (paSuccOdd (paSuccOdd (paSuccOdd (paSuccOdd sucb0))))))));
